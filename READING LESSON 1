<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reading Lesson 1 - English Teacher IA</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
        .conversation { background-color: #f9f9f9; padding: 10px; border-radius: 5px; margin-bottom: 20px; }
        .question { margin-bottom: 20px; }
        button { padding: 10px 15px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; }
    </style>
</head>
<body>

<div class="container">
    <h1>Reading Lesson 1</h1>
    
    <h2>Step 1: Listen to the Conversation</h2>
    <div class="conversation">
        <p><strong>Teacher Marisol:</strong> Good morning teacher, may I come in?</p>
        <p><strong>Anna:</strong> Sure, come in. What's your name?</p>
        <p><strong>Teacher Marisol:</strong> My name is Anna.</p>
        <p><strong>Anna:</strong> Nice to meet you, I'm teacher Marisol. Can you spell your name?</p>
        <p><strong>Teacher Marisol:</strong> A - N - N - A.</p>
    </div>

    <h2>Step 2: Comprehension Question</h2>
    <div class="question">
        <p>What is the name of the student in the conversation?</p>
        <input type="text" id="answer" placeholder="Type your answer here...">
        <br><br>
        <button onclick="checkAnswer()">Submit Answer</button>
    </div>
</div>

<script>
function checkAnswer() {
    const answer = document.getElementById('answer').value.toLowerCase();
    if (answer.includes('anna')) {
        alert("Correct! Anna is the student.");
    } else {
        alert("Incorrect, try again.");
    }
}
</script>

</body>
</html>
